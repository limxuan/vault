{
  "deletionDestination": "obsidian-option",
  "obsidianTrashCleanupAge": -1,
  "notifications": "showAll",
  "excludeInclude": 1,
  "excludedFolders": [
    "! Pasted Media"
  ],
  "attachmentsExcludeInclude": 1,
  "attachmentExtensions": [
    "*"
  ],
  "deletionConfirmation": true,
  "runOnStartup": false,
  "removeFolders": false,
  "ignoredFrontmatter": [],
  "ignoreAllFrontmatter": false,
  "codeblockTypes": [],
  "deleteEmptyMarkdownFiles": false,
  "deleteEmptyMarkdownFilesWithBacklinks": false,
  "fileAgeThreshold": 0,
  "closeNewTabs": false,
  "deleteEmptyFileOnClose": false,
  "debugLogging": false,
  "ExternalPlugins": {
    "Excalidraw": {
      "TreatAsAttachments": false
    }
  }
}